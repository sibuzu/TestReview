  "panels": [
    {
      "heading": "① 和平區是山地原住民區",
      "text": "阿承在臺中市和平區平等里。和平區具有自治地位，與一般行政區的區長任用制度不同。",
      "diagram": {
        "kind": "flow",
        "title": "阿承的戶籍層級",
        "items": [
          {
            "label": "臺中市：直轄市",
