          },
          {
            "label": "和平區：山地原住民區",
            "tone": "gold"
          },
          {
            "label": "平等里",
            "tone": "green"
          }
        ],
        "arrow": "由上往下判斷制度"
      },
      "alt": "臺中市、和平區、平等里層級及山地原住民區明標。"
    },
    {
      "heading": "② 市與自治區：A、B、C、D",
      "text": "先有臺中市長A、市議員B；和平區還能選區長C、區民代表D。依戶籍制度判斷，不是只看個人有無原住民身分。",
      "diagram": {
        "kind": "paths",
        "title": "市與自治區的公職",
        "items": [
          {
            "label": "市層級：A市長、B市議員",
            "tone": "blue"
          },
          {
            "label": "自治區：C區長、D區民代表",
            "tone": "purple"
          }
        ],
        "target": "先列出4類地方公職",
        "arrow": "兩層制度分別適用"
      },
      "alt": "中文標示市A/B、自治區C/D，各2類合計4類。"
    },
    {
      "heading": "③ 平等里長I也要選",
      "text": "別漏平等里的里長I，總共A、B、C、D、I五類。C已是本地區長，不能再把鄉鎮市長G重複加進來。",
      "diagram": {
        "kind": "flow",
        "title": "最後補上里長",
        "items": [
          {
            "label": "A、B、C、D：4類",
            "tone": "blue"
          },
          {
            "label": "加I：平等里長，合計5類",
            "tone": "green"
          }
        ],
        "arrow": "把里長加入完整清單"
      },
      "alt": "以中文及數字4類加里長I成5類，不使用件數或未標圖示。"
    }
  ],
