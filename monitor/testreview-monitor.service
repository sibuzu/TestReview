[Unit]
Description=WeiRuGo read-only curation monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jack/git/TestReview
ExecStart=/usr/bin/python3 /home/jack/git/TestReview/monitor/server.py --host 0.0.0.0 --port 8912
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
